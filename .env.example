# Copie para .env (ignorado pelo Git). Nunca coloque chaves reais neste arquivo.

# Só para testar a chave no terminal. O workflow usa a credencial criada no n8n.
GEMINI_API_KEY=cole_sua_chave_aqui

# Porta e endereço do n8n
N8N_PORT=5678
N8N_LISTEN_ADDRESS=127.0.0.1

# Desativa a telemetria
N8N_DIAGNOSTICS_ENABLED=false
